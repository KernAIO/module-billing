{
  "name": "@kernhq/module-billing",
  "version": "0.3.5",
  "description": "Kern billing module: plans, entitlements, subscriptions and Stripe — the mechanism that lets any Kern instance sell seats on itself",
  "homepage": "https://github.com/KernAIO/module-billing#readme",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KernAIO/module-billing.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "migrations",
    "src/client",
    "src/contract.ts"
  ],
  "exports": {
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "svelte": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./client/*": {
      "types": "./src/client/*",
      "svelte": "./src/client/*",
      "default": "./src/client/*"
    },
    "./migrations": "./migrations"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.client.json --threshold error",
    "lint": "biome check . && node scripts/check-ranges.mjs package.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "test:unit": "vitest run --exclude 'src/**/*.int.test.ts'",
    "format": "biome check --write .",
    "changeset": "changeset"
  },
  "dependencies": {
    "@kernhq/sdk": "^0.1.5",
    "@orpc/contract": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "drizzle-orm": "^0.45.0",
    "stripe": "^22.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.27.0",
    "@kernhq/contracts": "^0.7.0",
    "@kernhq/kernel": "^0.7.0",
    "@kernhq/tsconfig": "^0.1.0",
    "@kernhq/ui": "^0.10.0",
    "@tanstack/svelte-query": "^6.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "pg": "^8.16.0",
    "svelte": "^5.46.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "@kernhq/contracts": "^0.7.0",
    "@kernhq/kernel": "^0.7.0",
    "@kernhq/ui": "^0.10.0",
    "@tanstack/svelte-query": "^6.1.0",
    "svelte": "^5.46.0"
  },
  "peerDependenciesMeta": {
    "@kernhq/ui": {
      "optional": true
    },
    "@tanstack/svelte-query": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  }
}
